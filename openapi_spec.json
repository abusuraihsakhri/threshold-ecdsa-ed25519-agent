{
  "openapi": "3.1.0",
  "info": {
    "title": "Threshold telemetry evaluator demo API",
    "version": "3.0.0",
    "description": "Synthetic telemetry evaluation only; does not implement ECDSA, Ed25519, FROST, GG20 or clinical validation. No authentication; bind to localhost."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Status and version",
        "responses": {
          "200": {
            "description": "Status object"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Basic JSON counters",
        "responses": {
          "200": {
            "description": "JSON object with counts, not Prometheus text"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Apply three demonstration rules",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ],
                "properties": {
                  "task_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "target_identifier": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number",
                    "default": 0
                  },
                  "status_descriptor": {
                    "type": "string",
                    "maxLength": 64,
                    "default": "NOMINAL"
                  },
                  "is_critical_flag": {
                    "type": "boolean",
                    "default": false
                  },
                  "attributes": {
                    "type": "object",
                    "additionalProperties": true,
                    "default": {}
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Demonstration consensus dossier"
          },
          "422": {
            "description": "Invalid or sensitive-pattern-containing payload"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Local deterministic mock response",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mock text response"
          },
          "422": {
            "description": "Sensitive-pattern rejection"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Snapshot of in-memory HMAC audit trail",
        "responses": {
          "200": {
            "description": "Current process audit entries and integrity check"
          }
        }
      }
    }
  }
}
